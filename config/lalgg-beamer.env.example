# /etc/lalgg-beamer/config.env - the only configuration file on the box (mode 0600, root).
# Written by install/install.sh, edited by the local console or the agent.

# Where the kiosk browser goes and where the pairing screen lives.
MANAGE_URL=https://manage.lal.gg

# Directus instance the agent talks to (heartbeat, commands). Set at enrollment.
DIRECTUS_URL=https://directus.lockandload.ch

# Filled at enrollment (pairing flow or console menu 5). Empty = not enrolled: the
# agent only serves /info locally and the page shows the pairing code.
DEVICE_ID=
DEVICE_TOKEN=

# Heartbeat / command poll interval in seconds.
POLL_SECONDS=30

# sha256 of the local console PIN (install.sh asks for it).
CONSOLE_PIN_SHA256=

# 1 = Ctrl+Alt+F2 reaches the PIN console (default). 0 = no VT switching at all;
# the console is then only reachable through the "console" command from lal.gg.
KIOSK_ALLOW_VT_SWITCH=1

# Optional: override the start URL (default: $MANAGE_URL/beamer/device).
KIOSK_START_URL=

# Optional: extra Chromium flags, e.g. platform-specific video decode switches.
# Raspberry Pi 4/5:  --enable-features=VaapiVideoDecoder --disable-features=UseChromeOSDirectVideoDecoder
KIOSK_EXTRA_FLAGS=

# GitHub repo the self-update pulls releases from.
UPDATE_REPO=sven-g-nadler/lalgg-beamer-client
